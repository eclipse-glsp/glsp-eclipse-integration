{
  "name": "parent",
  "version": "2.9.0-next",
  "private": true,
  "scripts": {
    "app": "pnpm -C examples/workflow-webapp",
    "build": "pnpm compile && pnpm app bundle",
    "check:all": "pnpm build && pnpm lint && pnpm format:check && pnpm headers:check",
    "clean": "pnpm -r run clean",
    "compile": "tsc -b",
    "copy:client": "copyfiles -f ./examples/workflow-webapp/app/* ../server/example/org.eclipse.glsp.ide.workflow.editor/diagram",
    "fix:all": "pnpm lint:fix && pnpm format && pnpm headers:fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate:index": "pnpm -r generate:index && pnpm lint:fix",
    "headers:check": "glsp checkHeaders .. -f ts tsx java -e \"**/src-gen/**\"",
    "headers:fix": "glsp checkHeaders .. -f ts tsx java -e \"**/src-gen/**\" --autoFix",
    "preinstall": "npx only-allow pnpm",
    "lint": "oxlint .",
    "lint:ci": "node ./scripts/lint-report.mjs",
    "lint:fix": "pnpm lint --fix",
    "publish:latest": "glsp releng publish latest",
    "publish:next": "glsp releng publish next",
    "upgrade:next": "glsp updateNext",
    "watch": "concurrently --kill-others -n tsc,webapp -c red,yellow \"tsc -b -w --preserveWatchOutput\" \"pnpm -s app watch\""
  },
  "devDependencies": {
    "@eclipse-glsp/dev": "2.9.0-next.4",
    "@types/node": "24.x",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.4.0"
}
